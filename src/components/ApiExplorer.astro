---
import { Copy, Eye, RefreshCw, Send, ShieldCheck } from "@lucide/astro";

interface Props {
  method?: string;
  path: string;
  country?: string;
  body?: Record<string, unknown>;
  title?: string;
}
const isEnglish = Astro.url.pathname.startsWith("/en/");
const ui = isEnglish ? {
  title: "Test request", copyPath: "Copy endpoint path", tryIt: "Try it", subtitle: "Configure parameters and send a request to the test environment", close: "Close",
  country: "Country", environment: "Test environment", unavailable: "The test domain is not configured for this country", authentication: "Authentication", pending: "Not configured",
  authNotice: "The private key is used only in your browser to generate authorization. It is never sent or stored.", privateKey: "Merchant private key", keyPlaceholder: "PEM or Base64 PKCS#8 private key, or mock", toggleKey: "Show or hide private key", keyMemory: "Kept only in this page's memory and cleared when the dialog closes.",
  headers: "Request headers", local: "generated locally", waitKey: "Enter the merchant private key first", parameters: "Request body", result: "Response", resultHint: "After you send the request, the status, duration, and JSON response appear here.", security: "Authentication details remain only in this page's memory and are not written to local storage.",
  copyNote: "Copying cURL does not send a request", regenerate: "Regenerate credentials", copyCurl: "Generate and copy cURL", send: "Send test request", domainPending: "Test domain pending",
} : {
  title: "模拟请求", copyPath: "复制接口路径", tryIt: "Try it · 模拟请求", subtitle: "测试环境下配置参数并发送请求", close: "关闭",
  country: "国家", environment: "测试环境", unavailable: "该国家测试域名暂未配置", authentication: "请求鉴权", pending: "待配置",
  authNotice: "私钥仅在浏览器内用于生成 authorization，不会随请求发送或保存", privateKey: "商户私钥", keyPlaceholder: "PEM、Base64 PKCS#8 私钥或 mock", toggleKey: "显示或隐藏私钥", keyMemory: "仅保留在当前页面内存，关闭弹窗后自动清空",
  headers: "请求头", local: "本地生成", waitKey: "等待填写商户私钥", parameters: "请求参数", result: "响应结果", resultHint: "发送请求后，响应状态、耗时和 JSON 将显示在这里。", security: "认证信息仅保留在当前页面内存中，不会写入本地存储。",
  copyNote: "复制 cURL 不会发送请求", regenerate: "重新生成凭证", copyCurl: "生成并复制 cURL", send: "发送测试请求", domainPending: "测试域名待配置",
};
const { method = "POST", path, country = "ID", body = {}, title = ui.title } = Astro.props;
const initialBody = JSON.stringify(body, null, 2);
const countryNames: Record<string, string> = isEnglish
  ? { AR: "Argentina", BR: "Brazil", CO: "Colombia", ID: "Indonesia", IN: "India", KH: "Cambodia", KR: "South Korea", VN: "Vietnam" }
  : { AR: "阿根廷", BR: "巴西", CO: "哥伦比亚", ID: "印度尼西亚", IN: "印度", KH: "柬埔寨", KR: "韩国", VN: "越南" };
const testEnvironments: Record<string, string> = {
  AR: "https://ar-test-gateway.vellpay.com",
  BR: "https://br-test-gateway.vellpay.com",
  CO: "https://co-test-gateway.vellpay.com",
  ID: "https://id-test-gateway.vellpay.com",
  IN: "https://in-test-gateway.vellpay.com",
  KH: "https://kh-test-gateway.vellpay.com",
  KR: "https://kr-test-gateway.vellpay.com",
};
const countryName = `${countryNames[country] ?? country} · ${country}`;
const testEnvironment = testEnvironments[country] ?? "";
---

<vell-api-explorer data-method={method} data-path={path} data-country={country} data-base-url={testEnvironment} data-locale={isEnglish ? "en" : "zh"}>
  <div class="endpoint-actions"><button class="copy-path" data-copy-path title={ui.copyPath} aria-label={ui.copyPath}><Copy size={16} stroke-width={1.8} aria-hidden="true" /></button><button class="try-trigger" data-open><Send size={16} stroke-width={1.8} aria-hidden="true" />{ui.tryIt}</button></div>
  <dialog>
    <form method="dialog" class="dialog-shell">
      <header>
        <div><span class="eyebrow">API TEST CONSOLE</span><div class="console-title"><h2>{title}</h2><span class="test-badge">TEST ONLY</span></div><p>{ui.subtitle}</p></div>
        <button class="close" value="cancel" formnovalidate aria-label={ui.close}>×</button>
      </header>
      <div class="workspace">
        <section class="request-pane">
          <div class="request-line"><span>{method}</span><code>{path}</code></div>
          <div class="control-row">
            <label>{ui.country}<input value={countryName} disabled /></label>
            <label>{ui.environment}<input data-base-url value={testEnvironment} placeholder={ui.unavailable} disabled /></label>
          </div>
          <div class="auth-heading"><h3>{ui.authentication}</h3><span data-auth-state>{ui.pending}</span></div>
          <p class="auth-notice"><ShieldCheck size={16} />{ui.authNotice}</p>
          <div class="auth-row">
            <label>appId <b>*</b><input data-header="appId" autocomplete="off" placeholder="TEST_APP_ID" /></label>
            <label>{ui.privateKey} <b>*</b><span class="secret-input"><input data-private-key type="password" autocomplete="off" required placeholder={ui.keyPlaceholder} /><button type="button" data-toggle-key aria-label={ui.toggleKey}><Eye size={17} /></button></span><small>{ui.keyMemory}</small></label>
          </div>
          <h3>{ui.headers}</h3>
          <div class="header-grid">
            <label>nonce<input data-header="nonce" autocomplete="off" /></label>
            <label>timestamp<input data-header="timestamp" autocomplete="off" /></label>
            <label class="authorization-field">authorization ({ui.local})<input data-header="authorization" type="password" autocomplete="off" readonly placeholder={ui.waitKey} /></label>
          </div>
          <h3>{ui.parameters} <small>application/json</small></h3>
          <textarea data-body spellcheck="false">{initialBody}</textarea>
        </section>
        <section class="response-pane">
          <div class="response-heading"><h3>{ui.result}</h3><span class="response-hint">Response</span></div>
          <pre data-output><code>{testEnvironment ? ui.resultHint : ui.unavailable}</code></pre>
          <p class="security">{ui.security}</p>
        </section>
      </div>
      <footer>
        <p class="action-note" data-action-note>{ui.copyNote}</p>
        <button type="button" class="secondary" data-regenerate><RefreshCw size={16} />{ui.regenerate}</button>
        <button type="button" class="secondary" data-copy><Copy size={16} />{ui.copyCurl}</button>
        <button type="button" data-send disabled={!testEnvironment}><Send size={16} />{testEnvironment ? ui.send : ui.domainPending}</button>
      </footer>
    </form>
  </dialog>
</vell-api-explorer>

<script>
  class VellApiExplorer extends HTMLElement {
    message(key) {
      const messages = {
        en: { waitKey: "Enter the merchant private key first", pending: "Not configured", stale: "Regeneration required", requiredKey: "Merchant private key is required.", mockPlaceholder: "Mock mode (authorization is empty)", mock: "Mock mode", invalidJson: "Invalid JSON: the request body must contain valid JSON.", signed: "Signed", invalidKey: "Invalid private-key format or algorithm. Use a PEM or Base64 PKCS#8 RSA private key.", copied: "cURL copied; no network request was sent", copyNote: "Copying cURL does not send a request", pathCopied: "Copied", copyPath: "Copy endpoint path", sending: "Sending request to the test gateway…", sent: "Test request sent" },
        zh: { waitKey: "等待填写商户私钥", pending: "待配置", stale: "待重新生成", requiredKey: "商户私钥为必填项。", mockPlaceholder: "mock 模式（authorization 为空）", mock: "mock 模式", invalidJson: "JSON 格式错误：请求体必须是合法 JSON。", signed: "已签名", invalidKey: "私钥格式或算法不正确，请使用 PEM 或 Base64 格式的 PKCS#8 RSA 私钥。", copied: "cURL 已复制，未发送网络请求", copyNote: "复制 cURL 不会发送请求", pathCopied: "已复制", copyPath: "复制接口路径", sending: "正在向测试网关发送请求…", sent: "测试请求已发送" },
      };
      return messages[this.dataset.locale === "en" ? "en" : "zh"][key];
    }
    connectedCallback() {
      this.refreshRequestMeta();
      this.querySelector("[data-open]")?.addEventListener("click", () => {
        this.refreshRequestMeta();
        const dialog = this.querySelector("dialog");
        if (dialog instanceof HTMLDialogElement) dialog.showModal();
      });
      this.querySelector("dialog")?.addEventListener("click", (event) => {
        if (event.target === event.currentTarget && event.currentTarget instanceof HTMLDialogElement) event.currentTarget.close();
      });
      this.querySelector("dialog")?.addEventListener("close", () => {
        const key = this.querySelector("[data-private-key]");
        const authorization = this.querySelector('[data-header="authorization"]');
        const state = this.querySelector("[data-auth-state]");
        if (key instanceof HTMLInputElement) key.value = "";
        if (authorization instanceof HTMLInputElement) { authorization.value = ""; authorization.placeholder = this.message("waitKey"); }
        if (state) state.textContent = this.message("pending");
      });
      this.querySelector("[data-copy]")?.addEventListener("click", () => this.copyCurl());
      this.querySelector("[data-regenerate]")?.addEventListener("click", () => this.regenerateCredentials());
      this.querySelector("[data-toggle-key]")?.addEventListener("click", () => this.togglePrivateKey());
      this.querySelector("[data-private-key]")?.addEventListener("input", () => this.markAuthorizationStale());
      this.querySelector('[data-header="appId"]')?.addEventListener("input", () => this.markAuthorizationStale());
      this.querySelector("[data-body]")?.addEventListener("input", () => this.markAuthorizationStale());
      this.querySelector("[data-copy-path]")?.addEventListener("click", () => this.copyPath());
      this.querySelector("[data-send]")?.addEventListener("click", () => this.send());
      requestAnimationFrame(() => this.placeEndpointActions());
    }
    placeEndpointActions() {
      const endpoint = this.parentElement?.querySelector(".method-path");
      const actions = this.querySelector(".endpoint-actions");
      const path = endpoint?.querySelector("code");
      const copy = actions?.querySelector("[data-copy-path]");
      if (path && copy) path.insertAdjacentElement("afterend", copy);
      if (endpoint && actions) endpoint.append(actions);
    }
    refreshRequestMeta() {
      const nonce = this.querySelector('[data-header="nonce"]');
      const timestamp = this.querySelector('[data-header="timestamp"]');
      if (nonce instanceof HTMLInputElement && !nonce.value) nonce.value = this.createNonce();
      if (timestamp instanceof HTMLInputElement) timestamp.value = String(Date.now());
    }
    createNonce() {
      if (globalThis.crypto?.randomUUID) return globalThis.crypto.randomUUID().replaceAll("-", "");
      if (globalThis.crypto?.getRandomValues) {
        const bytes = globalThis.crypto.getRandomValues(new Uint8Array(16));
        return Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");
      }
      return `${Date.now().toString(36)}${Math.random().toString(36).slice(2)}${Math.random().toString(36).slice(2)}`;
    }
    togglePrivateKey() {
      const input = this.querySelector("[data-private-key]");
      if (input instanceof HTMLInputElement) input.type = input.type === "password" ? "text" : "password";
    }
    markAuthorizationStale() {
      const state = this.querySelector("[data-auth-state]");
      if (state) state.textContent = this.message("stale");
    }
    async regenerateCredentials() {
      const nonce = this.querySelector('[data-header="nonce"]');
      const timestamp = this.querySelector('[data-header="timestamp"]');
      if (nonce instanceof HTMLInputElement) nonce.value = this.createNonce();
      if (timestamp instanceof HTMLInputElement) timestamp.value = String(Date.now());
      await this.generateAuthorization();
    }
    async generateAuthorization() {
      const keyInput = this.querySelector("[data-private-key]");
      const authorization = this.querySelector('[data-header="authorization"]');
      const state = this.querySelector("[data-auth-state]");
      if (!(keyInput instanceof HTMLInputElement) || !(authorization instanceof HTMLInputElement)) return;
      const privateKey = keyInput.value.trim();
      if (!privateKey) {
        authorization.value = "";
        authorization.placeholder = this.message("waitKey");
        if (state) state.textContent = this.message("pending");
        throw new Error(this.message("requiredKey"));
      }
      if (privateKey === "mock") {
        authorization.value = "";
        authorization.placeholder = this.message("mockPlaceholder");
        if (state) state.textContent = this.message("mock");
        return;
      }
      let body;
      try { body = JSON.parse(this.querySelector("[data-body]")?.value || "{}"); }
      catch { throw new Error(this.message("invalidJson")); }
      const nonce = this.querySelector('[data-header="nonce"]')?.value || "";
      const raw = Object.entries(body).filter(([name, value]) => name !== "sign" && value != null && !(typeof value === "string" && !value.trim())).sort(([a], [b]) => a.localeCompare(b)).map(([name, value]) => `${name}=${typeof value === "object" ? JSON.stringify(value) : value}`).concat(`nonce=${nonce}`).join("&");
      try {
        const clean = privateKey.replace(/-----BEGIN [^-]+-----|-----END [^-]+-----|\s/g, "");
        const bytes = Uint8Array.from(atob(clean), (character) => character.charCodeAt(0));
        const importedKey = await crypto.subtle.importKey("pkcs8", bytes, { name: "RSASSA-PKCS1-v1_5", hash: "SHA-1" }, false, ["sign"]);
        const signature = await crypto.subtle.sign("RSASSA-PKCS1-v1_5", importedKey, new TextEncoder().encode(raw));
        authorization.value = btoa(String.fromCharCode(...new Uint8Array(signature)));
        if (state) state.textContent = this.message("signed");
      } catch { throw new Error(this.message("invalidKey")); }
    }
    requestData() {
      const value = (selector) => this.querySelector(selector)?.value || "";
      return {
        base: value("[data-base-url]").replace(/\/$/, ""), path: this.getAttribute("data-path") || "",
        method: this.getAttribute("data-method") || "POST",
        headers: { "Content-Type": "application/json", appId: value('[data-header="appId"]'), nonce: value('[data-header="nonce"]'), timestamp: value('[data-header="timestamp"]'), authorization: value('[data-header="authorization"]') },
        body: value("[data-body]"),
      };
    }
    async copyCurl() {
      try { await this.regenerateCredentials(); }
      catch (error) { this.showMessage(error instanceof Error ? error.message : String(error)); return; }
      const req = this.requestData();
      const headers = Object.entries(req.headers).map(([key, value]) => `-H '${key}: ${value}'`).join(" \\\n  ");
      const curl = `curl -X ${req.method} '${req.base || "https://TEST_DOMAIN"}${req.path}' \\\n  ${headers} \\\n  --data '${req.body.replaceAll("'", "'\\''")}'`;
      if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(curl);
      else {
        const textarea = document.createElement("textarea");
        textarea.value = curl; textarea.style.position = "fixed"; textarea.style.opacity = "0";
        document.body.append(textarea); textarea.select(); document.execCommand("copy"); textarea.remove();
      }
      const button = this.querySelector("[data-copy]");
      const note = this.querySelector("[data-action-note]");
      if (note) note.textContent = this.message("copied");
      if (button) button.classList.add("copied");
      setTimeout(() => { if (note) note.textContent = this.message("copyNote"); if (button) button.classList.remove("copied"); }, 1600);
    }
    async copyPath() {
      const path = this.getAttribute("data-path") || "";
      if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(path);
      else {
        const textarea = document.createElement("textarea");
        textarea.value = path; document.body.append(textarea); textarea.select(); document.execCommand("copy"); textarea.remove();
      }
      const button = this.querySelector("[data-copy-path]");
      if (button) { button.setAttribute("title", this.message("pathCopied")); setTimeout(() => button.setAttribute("title", this.message("copyPath")), 1200); }
    }
    async send() {
      try { await this.regenerateCredentials(); }
      catch (error) { this.showMessage(error instanceof Error ? error.message : String(error)); return; }
      const req = this.requestData();
      if (!req.base) return;
      const output = this.querySelector("[data-output] code");
      try {
        const note = this.querySelector("[data-action-note]");
        if (note) note.textContent = this.message("sending");
        const started = performance.now();
        const response = await fetch(`${req.base}${req.path}`, { method: req.method, headers: req.headers, body: req.body });
        const text = await response.text();
        let content = text;
        try { content = JSON.stringify(JSON.parse(text), null, 2); } catch {}
        if (output) output.textContent = `${response.status} · ${Math.round(performance.now() - started)}ms\n${content}`;
        if (note) note.textContent = this.message("sent");
      } catch (error) { this.showMessage(error instanceof Error ? error.message : String(error)); }
    }
    showMessage(message) {
      const output = this.querySelector("[data-output] code");
      if (output) output.textContent = message;
    }
  }
  if (!customElements.get("vell-api-explorer")) customElements.define("vell-api-explorer", VellApiExplorer);
</script>

<style>
  vell-api-explorer { display:contents; }.endpoint-actions{display:flex;gap:.5rem;margin-left:auto}
  .try-trigger { align-items:center; background:var(--color-primary,#0B6F69); border:0; border-radius:8px; color:white; cursor:pointer; display:flex; font-size:.78rem; font-weight:750; gap:.45rem; height:40px; padding:0 .85rem; }.try-trigger:hover{background:var(--color-primary-hover,#0F8F83)}
  .copy-path { align-items:center; background:var(--color-background,#fff); border:1px solid var(--color-border,#E2E8F0); border-radius:8px; color:var(--color-text-secondary,#64748B); cursor:pointer; display:inline-flex; flex:0 0 40px; height:40px; justify-content:center; width:40px; }.copy-path:hover{border-color:var(--color-primary);color:var(--color-primary)}
  dialog { background:transparent; border:0; color:#dbeafe; margin:auto; max-height:90vh; padding:0; width:min(70rem,94vw); }
  dialog::backdrop { backdrop-filter:blur(5px); background:rgba(2,8,18,.72); }
  .dialog-shell { background:#091522; border:1px solid #284253; border-radius:10px; box-shadow:0 18px 48px rgba(0,0,0,.28); overflow:hidden; }
  header { align-items:center; border-bottom:1px solid #213747; display:flex; justify-content:space-between; padding:1rem 1.2rem; }
  dialog header h2 { border:0!important; color:#f8fafc!important; font-size:1.2rem; margin:.15rem 0 0!important; padding:0!important; }
  .eyebrow { color:#5eead4; font-size:.65rem; font-weight:800; letter-spacing:.14em; }
  .close { background:transparent; border:0; color:#9fb4c2; cursor:pointer; font-size:1.8rem; line-height:1; }
  .workspace { display:grid; grid-template-columns:1.15fr .85fr; min-height:34rem; }
  .request-pane,.response-pane { padding:1.1rem 1.2rem; }
  .response-pane { background:#050d16; border-left:1px solid #213747; }
  .request-line { align-items:center; background:#06101b; border:1px solid #294251; border-radius:.55rem; display:flex; gap:.6rem; padding:.65rem; }
  .request-line span { background:#14b8a6; border-radius:.3rem; color:#04120f; font-size:.68rem; font-weight:900; padding:.3rem .45rem; }
  .request-line code { background:transparent!important; border:0!important; color:#d8e8ee!important; padding:0; }
  .control-row,.header-grid { display:grid; gap:.7rem; grid-template-columns:1fr 1fr; }
  dialog h3 { border:0!important; color:#f1f5f9!important; font-size:.82rem; margin:1rem 0 .45rem!important; padding:0!important; }
  h3 small { color:#6ee7d8; font-size:.65rem; font-weight:500; margin-left:.4rem; }
  label { color:#9fb4c2; display:block; font-size:.7rem; font-weight:650; margin-top:.7rem; }
  input,select,textarea { background:#06101b; border:1px solid #294251; border-radius:.45rem; color:#e6f4f3; display:block; font:500 .75rem ui-monospace,SFMono-Regular,Menlo,monospace; margin-top:.3rem; outline:none; padding:.6rem .68rem; width:100%; }
  input:focus,select:focus,textarea:focus { border-color:#2dd4bf; box-shadow:0 0 0 2px rgba(45,212,191,.12); }
  textarea { min-height:15rem; resize:vertical; }
  .response-heading { align-items:center; display:flex; justify-content:space-between; }
  .test-badge { background:#173244; border:1px solid #28516a; border-radius:999px; color:#7dd3fc; font-size:.62rem; font-weight:800; padding:.25rem .45rem; }
  pre { background:#02070d; border:1px solid #203745; border-radius:.55rem; min-height:26rem; overflow:auto; padding:.8rem; white-space:pre-wrap; }
  pre code { color:#8fb5c5; font-size:.7rem; }
  .security { color:#6f8795; font-size:.66rem; line-height:1.45; }
  footer { border-top:1px solid #213747; display:flex; gap:.65rem; justify-content:flex-end; padding:.85rem 1.2rem; }
  footer button { background:#2dd4bf; border:0; border-radius:8px; color:#05201d; cursor:pointer; font-size:.73rem; font-weight:800; min-height:40px; padding:.68rem 1rem; }
  footer button:disabled { cursor:not-allowed; opacity:.45; }
  footer .secondary { background:#173244; color:#b8e5e0; }
  @media(max-width:52rem) { vell-api-explorer { float:none; margin:.5rem 0 1rem; } .workspace { grid-template-columns:1fr; } .response-pane { border-left:0; border-top:1px solid #213747; } .control-row,.header-grid { grid-template-columns:1fr; } }

  /* API console — visual alignment with the supplied reference. */
  vell-api-explorer { --console-line:#2b4b60; --console-muted:#8da7bb; --console-accent:#24dfcf; }
  dialog { max-height:calc(100dvh - 48px); width:min(1370px,calc(100vw - 48px)); }
  dialog::backdrop { backdrop-filter:blur(8px); background:rgba(2,10,18,.84); }
  .dialog-shell { background:linear-gradient(145deg,#071827,#061522 64%,#081b29); border-color:#31546c; border-radius:14px; box-shadow:0 28px 90px rgba(0,0,0,.58),inset 0 0 64px rgba(15,132,151,.05); display:flex; flex-direction:column; height:min(968px,calc(100dvh - 48px)); }
  header { align-items:flex-start; flex:0 0 130px; padding:26px 34px 20px; }
  .eyebrow { color:var(--console-accent); font:800 13px/1.2 ui-monospace,monospace; letter-spacing:.14em; }
  .console-title { align-items:center; display:flex; gap:14px; margin-top:8px; }
  dialog header h2 { font-size:30px!important; line-height:1.1; margin:0!important; }
  header p { color:var(--console-muted); font-size:14px; margin:8px 0 0; }
  .test-badge { background:transparent; border-color:var(--console-accent); color:var(--console-accent); font-size:11px; padding:6px 10px; }
  .close { color:#a9bfd2; padding:0; }
  .workspace { flex:1 1 auto; grid-template-columns:54% 46%; min-height:0; overflow:hidden; }
  .request-pane,.response-pane { box-sizing:border-box; overflow-y:auto; padding:20px 28px; scrollbar-color:#89a5ba transparent; scrollbar-width:thin; }
  .response-pane { background:rgba(4,16,27,.45); border-color:var(--console-line); }
  .request-line { background:#091b29; border-color:#315773; min-height:48px; padding:4px; }
  .request-line span { background:linear-gradient(135deg,#21dfce,#0cc4b9); border-radius:5px; color:#032e33; font-size:12px; padding:11px 17px; }
  .request-line code { font-size:14px; margin-left:4px; }
  .control-row,.header-grid { gap:16px; }
  .auth-heading { align-items:center; display:flex; gap:10px; margin-top:18px; }
