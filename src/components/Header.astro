---
import Search from "@astrojs/starlight/components/Search.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
---
<div class="vp-header"><div class="brand"><SiteTitle {...Astro.props} /></div><div class="search"><Search {...Astro.props} /></div><div class="utilities"><LanguageSelect {...Astro.props} /><ThemeSelect {...Astro.props} /></div></div>
<style>.vp-header{align-items:center;display:flex;gap:1.3rem;height:100%}.brand{flex:0 0 auto}.search{flex:1 1 22.5rem;margin-inline:auto;max-width:22.5rem}.utilities{align-items:center;display:flex;gap:.35rem;margin-left:auto}.search :global(site-search button){width:100%}.search :global(site-search button span){font-size:0}.search :global(site-search button span)::after{color:var(--sl-color-gray-3);content:"搜索文档或接口…";font-size:.84rem}:global(html[lang="en"]) .search :global(site-search button span)::after{content:"Search docs or APIs…"}@media(max-width:50rem){.search{max-width:none}.utilities{display:flex}}</style>
