---
import type { Props } from "@astrojs/starlight/props";
import {
  ArrowDownLeft,
  ArrowUpRight,
  BellRing,
  ChevronDown,
  ChevronRight,
  CreditCard,
  FileSearch,
  Globe2,
  Layers3,
  ListFilter,
  Map,
  MapPinned,
  RefreshCw,
  Rocket,
  Search,
  ShieldCheck,
  UserRoundCheck,
  WalletCards,
} from "@lucide/astro";
import { countryGroups } from "../data/countries";

const { slug } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const parts = slug.split("/").filter(Boolean);
const locale = parts[0] === "en" ? "en" : "zh";
const isEnglish = locale === "en";
const localizedParts = ["zh", "en"].includes(parts[0]) ? parts.slice(1) : parts;
const currentCountry = localizedParts[0] ?? "";
const currentPath = `/${localizedParts.join("/")}`;
const href = (path: string) => `${base}/${locale}${path}/`;
const label = (zh: string, en: string) => isEnglish ? en : zh;
const englishCountryNames: Record<string, string> = { argentina: "Argentina", brazil: "Brazil", cambodia: "Cambodia", colombia: "Colombia", india: "India", indonesia: "Indonesia", korea: "South Korea", vietnam: "Vietnam" };

const guideSections = [
  { label: isEnglish ? "Get started" : "开始接入", icon: Rocket, links: [{ label: isEnglish ? "Quick start" : "快速开始", path: "/guides/quick-start" }, { label: isEnglish ? "Integration guide" : "接入指引", path: "/guides/getting-started" }] },
  { label: isEnglish ? "API security" : "API 安全", icon: ShieldCheck, links: [{ label: isEnglish ? "Create keys" : "创建密钥", path: "/guides/create-keys" }, { label: isEnglish ? "Authentication" : "接口鉴权", path: "/guides/authentication" }] },
  { label: isEnglish ? "Common reference" : "公共参数", icon: Layers3, links: [
    { label: isEnglish ? "Request headers" : "公共请求头", path: "/guides/request-headers" },
    { label: isEnglish ? "Responses" : "公共响应", path: "/guides/common-response" },
    { label: isEnglish ? "Order status" : "订单状态", path: "/guides/order-status" },
    { label: isEnglish ? "Error codes" : "公共错误码", path: "/guides/error-codes" },
  ] },
];

const countryLinks = (country: (typeof countryGroups)[number]["countries"][number]) => [
  ...(["argentina", "colombia"].includes(country.slug) ? [{ label: label("创建收银台", "Create checkout"), icon: CreditCard, path: `/${country.slug}/checkout/create` }] : []),
  { label: label("创建代收", "Create pay-in"), icon: ArrowDownLeft, path: `/${country.slug}/payin/create` },
  { label: label("查询代收", "Query pay-in"), icon: Search, path: `/${country.slug}/payin/query` },
  { label: label("代收回调", "Pay-in callback"), icon: BellRing, path: `/${country.slug}/payin/callback` },
  { label: label("创建代付", "Create payout"), icon: ArrowUpRight, path: `/${country.slug}/payout/create` },
  { label: label("银行编码", "Bank codes"), icon: ListFilter, path: `/${country.slug}/payout/banks` },
  { label: label("查询代付", "Query payout"), icon: Search, path: `/${country.slug}/payout/query` },
  { label: label("代付回调", "Payout callback"), icon: BellRing, path: `/${country.slug}/payout/callback` },
  { label: label("余额查询", "Balance query"), icon: WalletCards, path: `/${country.slug}/inquire/balance` },
  ...(country.slug === "cambodia" ? [
    { label: label("创建 KYC", "Create KYC"), icon: UserRoundCheck, path: "/cambodia/kyc/create" },
    { label: label("查询 KYC", "Query KYC"), icon: Search, path: "/cambodia/kyc/query" },
    { label: label("KYC 回调", "KYC callback"), icon: BellRing, path: "/cambodia/kyc/callback" },
    { label: label("额度说明", "Limits"), icon: ShieldCheck, path: "/cambodia/limits" },
  ] : []),
  ...(country.slug === "argentina" ? [
    { label: label("悬账列表", "Suspense list"), icon: ListFilter, path: "/argentina/suspense/list" },
    { label: label("凭证查询", "Receipt query"), icon: FileSearch, path: "/argentina/suspense/query" },
    { label: label("悬账补单", "Reconcile order"), icon: RefreshCw, path: "/argentina/suspense/reorder" },
  ] : []),
];
---

<nav class="vp-sidebar" aria-label={isEnglish ? "Documentation navigation" : "文档导航"}>
  <div class="guide-sections">
    {guideSections.map((section) => {
      const active = section.links.some((link) => currentPath === link.path);
      const SectionIcon = section.icon;
      return <details class="guide-section" open={active}>
        <summary class:list={{ active }}><SectionIcon class="nav-icon" size={18} stroke-width={1.8} aria-hidden="true" />{section.label}<span class="chevrons"><ChevronRight size={18} stroke-width={1.8} /><ChevronDown size={18} stroke-width={1.8} /></span></summary>
        <div class="guide-links">{section.links.map((link) => <a class:list={{ current: currentPath === link.path }} href={href(link.path)}>{link.label}</a>)}</div>
      </details>;
    })}
  </div>

  <div class="countries-heading"><Globe2 size={18} stroke-width={1.8} aria-hidden="true" />{isEnglish ? "Countries and regions" : "国家与地区"}</div>
  {countryGroups.map((group) => {
    const regionActive = group.countries.some((country) => country.slug === currentCountry);
    return <details class:list={{ region: true, active: regionActive }} open={regionActive}>
      <summary class="region-label">{group.id === "asia" ? <Map size={18} stroke-width={1.8} aria-hidden="true" /> : <MapPinned size={18} stroke-width={1.8} aria-hidden="true" />}<b>{isEnglish ? (group.id === "asia" ? "Asia" : "Latin America") : group.label}</b><small>{group.countries.length} {isEnglish ? "countries" : "个国家"}</small><span class="chevrons"><ChevronRight size={18} stroke-width={1.8} /><ChevronDown size={18} stroke-width={1.8} /></span></summary>
      <div class="country-list">
        {group.countries.map((country) => {
          const countryActive = country.slug === currentCountry;
          return <details class="vp-country" data-country={country.slug} open={countryActive}>
            <summary class:list={{ active: countryActive }}>
              <img class="flag" src={`https://flagcdn.com/w40/${country.code.toLowerCase()}.png`} alt={`${isEnglish ? englishCountryNames[country.slug] : country.name} flag`} width="24" height="18" loading="lazy" /><span class="country-name">{isEnglish ? englishCountryNames[country.slug] : country.name}</span><small>{country.code}</small><span class="chevrons"><ChevronRight size={18} stroke-width={1.8} /><ChevronDown size={18} stroke-width={1.8} /></span>
            </summary>
            <div class="country-pages">
              {countryLinks(country).map((link) => {
                const LinkIcon = link.icon;
                return <a class:list={{ current: currentPath === link.path }} href={href(link.path)}><LinkIcon size={16} stroke-width={1.8} aria-hidden="true" />{link.label}</a>;
              })}
            </div>
          </details>;
        })}
      </div>
    </details>;
  })}
</nav>

<script>
  document.querySelectorAll(".vp-sidebar").forEach((sidebar) => {
    sidebar.querySelectorAll(".vp-country").forEach((country) => {
      country.addEventListener("toggle", () => {
        if (!(country instanceof HTMLDetailsElement) || !country.open) return;
        sidebar.querySelectorAll(".vp-country[open]").forEach((other) => {
          if (other !== country && other instanceof HTMLDetailsElement) other.open = false;
        });
      });
    });
  });
</script>

<style>
  .vp-sidebar { color:var(--sl-color-gray-2); font-size:.875rem; padding:.65rem .55rem 2rem; }
  details { margin:0; }
  summary { align-items:center; border-radius:7px; cursor:pointer; display:flex; gap:10px; list-style:none; min-height:2.45rem; padding:.4rem .6rem; }
  summary::-webkit-details-marker { display:none; }
  summary:hover { color:var(--color-primary-hover); }
  .guide-section summary { color:var(--color-text); font-weight:650; }
  .guide-section summary.active { color:var(--color-primary); }
  :global(.nav-icon),.countries-heading :global(svg),.region-label :global(svg),.chevrons :global(svg) { color:#7890a3; flex:0 0 18px; height:18px; stroke-width:1.8; width:18px; }
  summary:hover :global(.nav-icon),summary:hover .chevrons :global(svg),.region-label:hover :global(svg) { color:var(--color-primary-hover); }
  summary.active :global(.nav-icon),summary.active .chevrons :global(svg) { color:var(--sl-color-accent); }
  .chevrons { display:grid; height:18px; margin-left:auto; place-items:center; width:18px; }
  .chevrons :global(svg) { grid-area:1/1; }.chevrons :global(svg:last-child) { display:none; }details[open]>summary .chevrons :global(svg:first-child) { display:none; }details[open]>summary .chevrons :global(svg:last-child) { display:block; }
  .guide-links,.country-pages { display:grid; padding:.15rem 0 .35rem 2.35rem; }
  .guide-links a,.country-pages a { border-left:1px solid color-mix(in srgb,var(--color-border) 45%,transparent); color:var(--sl-color-gray-2); line-height:1.35; padding:.42rem .7rem; text-decoration:none; }
  .guide-links a:hover,.country-pages a:hover { color:var(--color-primary-hover); }
  .guide-links a.current { border-left-color:var(--color-primary); color:var(--color-primary); font-weight:650; }
  .countries-heading { align-items:center; background:var(--color-selected); border:1px solid color-mix(in srgb,var(--color-primary) 16%,var(--color-border)); border-radius:8px; color:var(--color-primary); display:flex; font-size:.82rem; font-weight:750; gap:10px; letter-spacing:.02em; margin:1rem .2rem .55rem; padding:.6rem .55rem; }
  .region { border-left:2px solid transparent; margin:.25rem 0 .7rem; }
  .region.active { border-left-color:transparent; }
  .region-label { align-items:center; color:var(--sl-color-gray-2); display:flex; gap:10px; min-height:2.2rem; padding:.35rem .55rem; }
  .region.active .region-label :global(svg) { color:var(--color-primary); }.region-label b { color:var(--color-text); font-weight:680; }.region-label small { color:var(--sl-color-gray-3); font-size:.68rem; margin-left:auto; }.region-label .chevrons{margin-left:0}
  .country-list { margin-left:.45rem; }
  .vp-country>summary { position:relative; }
  .vp-country>summary.active { background:var(--color-selected); color:var(--color-primary); font-weight:720; }
  .vp-country>summary.active::before { background:var(--color-primary); border-radius:2px; content:""; height:1.5rem; left:-.55rem; position:absolute; width:3px; }
  .flag { border-radius:2px; height:18px; object-fit:cover; width:24px; }.country-name { color:var(--color-text); }.vp-country summary small { color:var(--sl-color-gray-3); font-size:.68rem; margin-left:auto; text-align:right; }.vp-country summary .chevrons { margin-left:0; }
  .country-pages { padding-left:1.8rem; }
  .country-pages a { align-items:center; display:flex; gap:10px; }
  .country-pages a :global(svg) { color:#7890a3; flex:0 0 16px; height:16px; stroke-width:1.8; width:16px; }
  .country-pages a:hover :global(svg) { color:var(--color-primary-hover); }.country-pages a.current :global(svg) { color:var(--color-primary); }
  .country-pages a.current { background:transparent; border-left-color:var(--color-primary); border-radius:0; color:var(--color-primary); font-weight:650; }
  @media(max-width:50rem) { .vp-sidebar { padding-bottom:1rem; } }
</style>
