---
import type { CountryConfig } from "../data/countries";

interface Props {
  country: CountryConfig;
}

const { country } = Astro.props;
const isEnglish = country.locale === "en";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) => `${base}/${isEnglish ? "en" : "zh"}${path}/`;
const capabilityIcon = { payin: "↓", payout: "↑", checkout: "▭" };
const [timezoneName, timezoneOffset = country.timezone] = country.timezone.split(" (");
---

<div class="country-overview">
  <header class="country-hero">
    <div class="flag" aria-hidden="true">{country.flag}</div>
    <div>
      <div class="identity"><span>{country.name}</span><code>{country.code}</code><code>{country.currency}</code></div>
      <p>{country.summary}</p>
    </div>
  </header>

  <section class="facts" aria-label={isEnglish ? `${country.name} integration details` : `${country.name}接入信息`}>
    <div><span class="fact-icon">◉</span><small>{isEnglish ? "Currency" : "币种"}</small><strong>{country.currency}</strong><p>{country.currencyName}</p></div>
    <div><span class="fact-icon">◷</span><small>{isEnglish ? "Time zone" : "时区"}</small><strong>{timezoneName}</strong><p>{timezoneOffset.replace(")", "")}</p></div>
    <div><span class="fact-icon">▤</span><small>{isEnglish ? "Capabilities" : "支持能力"}</small><strong>{country.capabilities.map((item) => item.label.split(" ")[0]).join(" · ")}</strong><p>{isEnglish ? "Covers major local payment scenarios" : "覆盖本地主要支付场景"}</p></div>
  </section>

  <div class="capability-grid">
    {country.capabilities.map((item) => (
      <a class:list={["capability", item.tone]} href={href(item.href)}>
        <span class="capability-icon">{capabilityIcon[item.tone]}</span>
        <div><strong>{item.label}</strong><p>{item.description}</p><span>{isEnglish ? "View API" : "查看接口"} <b>→</b></span></div>
      </a>
    ))}
  </div>

  <h2 id="payment-methods">{isEnglish ? "Supported payment methods" : "支持的支付方式"}</h2>
  <div class="payment-methods">
    {country.paymentMethods.map((method) => <span>{method}</span>)}
  </div>

  <h2 id="integration-notes">{isEnglish ? "Integration notes" : "接入注意事项"}</h2>
  <div class="notice-table" role="table" aria-label={isEnglish ? `${country.name} integration notes` : `${country.name}接入注意事项`}>
    {country.notices.map((notice) => (
      <div class="notice-row" role="row"><strong role="cell">{notice.label}</strong><span role="cell">{notice.description}</span></div>
    ))}
  </div>
</div>

<style>
  .country-overview { margin-top:.5rem; }
  .country-hero { align-items:center; display:flex; gap:1.25rem; margin:0 0 1.5rem; }
  .flag { align-items:center; background:linear-gradient(145deg,var(--sl-color-gray-6),var(--sl-color-gray-7)); border:1px solid var(--sl-color-hairline-light); border-radius:1rem; box-shadow:0 12px 30px color-mix(in srgb,var(--sl-color-black) 12%,transparent); display:flex; font-size:3.4rem; height:5rem; justify-content:center; width:7rem; }
  .identity { align-items:center; display:flex; flex-wrap:wrap; gap:.55rem; }
  .identity span { color:var(--sl-color-white); font-size:1.45rem; font-weight:760; }
  .identity code { background:color-mix(in srgb,var(--sl-color-accent-low) 75%,transparent); border:0; border-radius:.45rem; color:var(--sl-color-accent-high); font-size:.72rem; font-weight:750; padding:.32rem .55rem; }
  .country-hero p { color:var(--sl-color-gray-2); margin:.45rem 0 0; }
  .facts { border:1px solid var(--sl-color-hairline-light); border-radius:.8rem; display:grid; grid-template-columns:repeat(3,1fr); margin-bottom:1.25rem; overflow:hidden; }
  .facts>div { display:grid; grid-template-columns:auto 1fr; grid-template-rows:auto auto auto; padding:1.1rem 1.25rem; position:relative; }
  .facts>div+div { border-left:1px solid var(--sl-color-hairline-light); }
  .fact-icon { color:var(--sl-color-accent); font-size:1.35rem; grid-row:1/4; margin-right:.85rem; }
  .facts small { color:var(--sl-color-gray-3); font-size:.72rem; font-weight:700; }
  .facts strong { color:var(--sl-color-white); font-size:.95rem; margin-top:.1rem; }
  .facts p { color:var(--sl-color-gray-3); font-size:.72rem; margin:.15rem 0 0; }
  .capability-grid { display:grid; gap:1rem; grid-template-columns:repeat(3,1fr); margin:1.2rem 0 2rem; }
  .capability { background:linear-gradient(145deg,color-mix(in srgb,var(--sl-color-accent-low) 22%,transparent),transparent); border:1px solid color-mix(in srgb,var(--sl-color-accent) 30%,var(--sl-color-hairline)); border-radius:.8rem; color:inherit; display:flex; gap:.85rem; padding:1.05rem; text-decoration:none; transition:transform .16s ease,border-color .16s ease; }
  .capability:hover { border-color:var(--sl-color-accent); transform:translateY(-2px); }
  .capability-icon { align-items:center; background:var(--sl-color-accent); border-radius:.55rem; color:#fff; display:flex; flex:0 0 2.35rem; font-size:1.25rem; height:2.35rem; justify-content:center; }
  .capability.payout .capability-icon { background:#2684ff; }.capability.checkout .capability-icon { background:#7457e8; }
  .capability strong { color:var(--sl-color-white); }.capability p { color:var(--sl-color-gray-2); font-size:.8rem; line-height:1.55; margin:.45rem 0 .65rem; }.capability div>span { color:var(--sl-color-accent-high); font-size:.78rem; font-weight:700; }
  .country-overview h2 { border:0; color:var(--sl-color-white); font-size:1.2rem; margin:1.8rem 0 .85rem; padding:0; }
  .payment-methods { border:1px solid var(--sl-color-hairline-light); border-radius:.75rem; display:flex; flex-wrap:wrap; gap:.65rem; padding:1rem; }
  .payment-methods span { background:var(--sl-color-gray-6); border:1px solid var(--sl-color-hairline-light); border-radius:.55rem; color:var(--sl-color-gray-1); font-size:.78rem; font-weight:650; padding:.5rem .7rem; }
  .notice-table { border:1px solid var(--sl-color-hairline-light); border-radius:.7rem; overflow:hidden; }
  .notice-row { display:grid; grid-template-columns:minmax(7rem,22%) 1fr; }
  .notice-row+.notice-row { border-top:1px solid var(--sl-color-hairline-light); }
  .notice-row strong,.notice-row span { padding:.72rem .9rem; }.notice-row strong { background:color-mix(in srgb,var(--sl-color-gray-6) 72%,transparent); color:var(--sl-color-white); font-size:.78rem; }.notice-row span { color:var(--sl-color-gray-2); font-size:.8rem; }
  :global([data-theme="light"]) .identity span,:global([data-theme="light"]) .facts strong,:global([data-theme="light"]) .capability strong,:global([data-theme="light"]) .country-overview h2,:global([data-theme="light"]) .notice-row strong { color:#17352d; }
  @media(max-width:60rem) { .capability-grid { grid-template-columns:1fr; }.facts { grid-template-columns:1fr; }.facts>div+div { border-left:0; border-top:1px solid var(--sl-color-hairline-light); } }
  @media(max-width:35rem) { .country-hero { align-items:flex-start; }.flag { font-size:2.4rem; height:4rem; width:5rem; }.identity span { flex-basis:100%; }.notice-row { grid-template-columns:1fr; }.notice-row span { padding-top:.2rem; } }
</style>
